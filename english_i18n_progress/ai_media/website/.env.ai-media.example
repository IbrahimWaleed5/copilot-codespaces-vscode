# ===== AI media providers (copy what you need into .env) =====
# Order of image providers: first that works wins
AI_IMAGE_PROVIDERS=gemini,cloudflare,huggingface,self_hosted
AI_IMAGE_TRANSLATE_PROMPTS=true

# Cloudflare Workers AI (free: 10,000 Neurons/day)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# Hugging Face
HUGGINGFACE_TOKEN=
HUGGINGFACE_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell

# Your own GPU server (AUTOMATIC1111/Forge = a1111, or comfyui)
SELF_HOSTED_IMAGE_DRIVER=a1111
SELF_HOSTED_IMAGE_URL=
SELF_HOSTED_IMAGE_TOKEN=
# ComfyUI workflows (Save API Format) with {{PROMPT}} {{NEGATIVE}} {{SEED}}
COMFYUI_IMAGE_WORKFLOW=
COMFYUI_VIDEO_WORKFLOW=

# Video: Gemini Veo (paid) then ComfyUI
AI_VIDEO_ENABLED=true
AI_VIDEO_PROVIDERS=veo,comfyui
GEMINI_VIDEO_MODEL=veo-3.1-generate-preview
AI_VIDEO_ASPECT_RATIO=16:9
AI_VIDEO_CREDITS=150
AI_VIDEO_MAX_MINUTES=20
