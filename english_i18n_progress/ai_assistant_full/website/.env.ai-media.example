# ===== AI media providers (copy what you need into .env) =====
# Order of image providers: first that works wins
AI_IMAGE_PROVIDERS=gemini,cloudflare,huggingface,self_hosted
AI_IMAGE_TRANSLATE_PROMPTS=true

# Cloudflare Workers AI (free: 10,000 Neurons/day)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# Hugging Face
HUGGINGFACE_TOKEN=
HUGGINGFACE_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell

# Your own GPU server (AUTOMATIC1111/Forge = a1111, or comfyui)
SELF_HOSTED_IMAGE_DRIVER=a1111
SELF_HOSTED_IMAGE_URL=
SELF_HOSTED_IMAGE_TOKEN=
# ComfyUI workflows (Save API Format) with {{PROMPT}} {{NEGATIVE}} {{SEED}}
COMFYUI_IMAGE_WORKFLOW=
COMFYUI_VIDEO_WORKFLOW=

# Video: Gemini Veo (paid) then ComfyUI
AI_VIDEO_ENABLED=true
AI_VIDEO_PROVIDERS=veo,comfyui
GEMINI_VIDEO_MODEL=veo-3.1-generate-preview
AI_VIDEO_ASPECT_RATIO=16:9
AI_VIDEO_CREDITS=150
AI_VIDEO_MAX_MINUTES=20

# ===== Smart assistant: stronger model, long memory, agents =====
# Stronger model for programming/engineering/expert levels (empty = use GEMINI_MODEL)
GEMINI_PRO_MODEL=gemini-2.5-pro
GEMINI_PRO_TIMEOUT=180
AI_MAX_OUTPUT_TOKENS=16384
# Long conversations
AI_CONTEXT_CHARS=120000
AI_CONTEXT_MESSAGES=120
AI_SUMMARY_TRIGGER_CHARS=12000
AI_ROLLOVER_MESSAGES=400
AI_ROLLOVER_CHARS=800000
# Agents team (planner -> workers -> reviewer) for complex tasks
AI_AGENTS_ENABLED=true
AI_AGENTS_MAX_STEPS=5

# ===== Credits linkage =====
# Pro model tokens count this many times in Credits (Google charges more for it)
AI_PRO_MODEL_CREDIT_MULTIPLIER=4
# Conversation context per level (characters): more context = more Credits per message
AI_CONTEXT_CHARS_FAST=20000
AI_CONTEXT_CHARS_SMART=40000
AI_CONTEXT_CHARS_PROGRAMMING=80000
AI_CONTEXT_CHARS_ENGINEERING=80000
AI_CONTEXT_CHARS_DESIGN3D=100000
AI_CONTEXT_CHARS_EXPERT=120000
